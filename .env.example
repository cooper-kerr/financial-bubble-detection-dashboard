# Public URL of the Vercel Blob store used by the Yahoo pipeline.
BLOB_BASE_URL=https://your-public-blob-store.example

# Server-side credentials. Never expose these through VITE_* variables.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
FRED_API_KEY=replace-with-fred-api-key

# Optional: override the dashboard's runtime mapping URL.
VITE_YAHOO_BLOB_MAPPING_URL=https://your-public-blob-store.example/blob_mapping.json
